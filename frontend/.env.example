# Mocks por módulo (se fijan al compilar)
# Landing: usar las historias de ejemplo (el adaptador real aún no existe)
NEXT_PUBLIC_USAR_MOCKS_LANDING=true
# URL pública del sitio (opcional)
NEXT_PUBLIC_URL_SITIO=
# Eventos: usar el adaptador de ejemplo (el Http aún no existe)
NEXT_PUBLIC_USAR_MOCKS_EVENTOS=true
# Aliados: usar el adaptador de ejemplo (el Http aún no existe)
NEXT_PUBLIC_USAR_MOCKS_ALIADOS=true

# Acceso (cuentas e inicio de sesión): true usa el adaptador simulado; con cualquier otro valor se usa la API del backend.
# Se fija al compilar: tras cambiarla hay que volver a compilar.
NEXT_PUBLIC_USAR_MOCKS_ACCESO=true
# Solo de servidor (sin NEXT_PUBLIC: nunca deben llegar al navegador). Hacen falta si el simulado de acceso está apagado.
# Dirección de la API del backend. Debe ser https; http solo en localhost para desarrollar.
URL_API=
# Secreto compartido con el backend (32 caracteres o más): con él se reenvía la IP real de cada persona.
# Es el mismo valor que SECRETO_INTERNO del backend. Obligatorio en producción.
SECRETO_INTERNO_API=

# Fundadores (perfil): usar el adaptador simulado (el Http aun no existe)
NEXT_PUBLIC_USAR_MOCKS_FUNDADORES=true

# Habilidades (respuestas del recorrido): usar el adaptador simulado (el Http aun no existe)
NEXT_PUBLIC_USAR_MOCKS_HABILIDADES=true

# Perfil (Mi perfil): usar el adaptador simulado (el Http aun no existe)
NEXT_PUBLIC_USAR_MOCKS_PERFIL=true
