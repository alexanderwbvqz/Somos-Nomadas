# Copia este archivo a .env y rellena los valores. El .env nunca se sube.

# Entorno: desarrollo | produccion. Si se olvida, vale produccion (reglas estrictas): en local hay que pedir desarrollo
ENTORNO=desarrollo

# Donde se guardan los datos: supabase | memoria. memoria solo sirve para desarrollo (se pierde al apagar) y
# la configuracion se niega a arrancar asi en produccion.
ALMACEN_DE_DATOS=supabase

# Supabase usado solo como base de datos. La clave de servidor va solo aqui.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto con el que el backend firma sus JWT (largo y aleatorio)
JWT_SECRETO=

# Origenes del frontend permitidos por CORS, separados por comas. Sin comodin; en produccion, solo https
ORIGENES_PERMITIDOS=http://localhost:3000

# true por defecto. Solo se pone en false en desarrollo, mientras no exista el envio de correos
EXIGIR_CORREO_CONFIRMADO=true

# Secreto con el que se firman las huellas del limite de intentos (32 caracteres o mas). Distinto de JWT_SECRETO
HUELLAS_SECRETO=

# Version de la politica de datos que se guarda como prueba del consentimiento (poner la real)
POLITICA_VERSION=v1

# Secreto compartido con el servidor de Next (32 caracteres o mas, distinto de JWT_SECRETO y HUELLAS_SECRETO).
# Con el, Next reenvia la IP real de cada persona; sin el, el backend usa la IP de la conexion (la de Next).
# Obligatorio en produccion.
SECRETO_INTERNO=

# Envio de correos (enlace para confirmar el correo). Sin definirlo: resend en produccion y carpeta en desarrollo.
#   resend:  los envia de verdad con la API de Resend (obligatorio en produccion)
#   carpeta: no envia nada; escribe cada correo como archivo en CARPETA_DE_CORREOS, para desarrollar y probar
# ENVIADOR_DE_CORREOS=carpeta
# Clave de la API de Resend (empieza por re_). Secreta: solo aqui y en Render
RESEND_CLAVE=
# Quien firma los correos (el dominio tiene que estar verificado en Resend)
CORREO_REMITENTE=Somos Nómadas <hola@somosnomadas.app>
# La web, para armar los enlaces de los correos (https en produccion)
URL_WEB=http://localhost:3000
# Solo con ENVIADOR_DE_CORREOS=carpeta
CARPETA_DE_CORREOS=correos-de-prueba
