# Mocks por módulo (se fijan al compilar)
NEXT_PUBLIC_USAR_MOCKS_LANDING=true
# URL pública del sitio (opcional)
NEXT_PUBLIC_URL_SITIO=
# Eventos: usar el adaptador de ejemplo (el Http aún no existe)
NEXT_PUBLIC_USAR_MOCKS_EVENTOS=true
# Aliados: usar el adaptador de ejemplo (el Http aún no existe)
NEXT_PUBLIC_USAR_MOCKS_ALIADOS=true

# Acceso (cuentas e inicio de sesión): usar el adaptador simulado (el Http aún no existe)
NEXT_PUBLIC_USAR_MOCKS_ACCESO=true
